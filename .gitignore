# Ignore everything by default
*

# Allow tracked files
!.gitignore
!README.md
!scripts/
!scripts/*.sh

!niri/
!niri/config.kdl
!niri/wallpapers/
!niri/wallpapers/*
!niri/scripts/
!niri/scripts/*

!eww/
!eww/eww.yuck
!eww/eww.css
!eww/scripts/
!eww/scripts/*.sh
!eww/scripts/fuzzel

!ghostty/
!ghostty/config.ghostty
!ghostty/auto/
!ghostty/auto/theme.ghostty

!swaylock/
!swaylock/config
!swaylock/lock.sh

!fuzzel/
!fuzzel/fuzzel.ini

!networkmanager-dmenu/
!networkmanager-dmenu/config.ini

!mako/
!mako/config

!swayosd/
!swayosd/style.css
!brave-flags.conf

!cliphist/
!cliphist/config

!autostart/
!autostart/*.desktop

!pipewire/
!pipewire/pipewire.conf.d/
!pipewire/pipewire.conf.d/*.conf

!wireplumber/
!wireplumber/wireplumber.conf.d/
!wireplumber/wireplumber.conf.d/*.conf

!xdg-desktop-portal/
!xdg-desktop-portal/*.conf

!systemd/
!systemd/user/
!systemd/user/niri-*.service
!systemd/user/niri.service.wants/
!systemd/user/niri.service.wants/niri-*.service
