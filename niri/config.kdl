prefer-no-csd

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"

    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

overview {
    zoom 0.4
    backdrop-color "#000000"

    workspace-shadow {
        off
    }
}

recent-windows {
    open-delay-ms 100

    highlight {
        active-color "#333333"
        urgent-color "#e04f5f"
        padding 8
        corner-radius 0
    }

    previews {
        max-height 320
        max-scale 0.35
    }

    binds {
        Alt+Tab       { next-window scope="workspace"; }
        Alt+Shift+Tab { previous-window scope="workspace"; }
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 2000
}

input {
    keyboard {
        xkb {
            layout "us"
        }
        // numlock disabled — numlock overlays letters on laptop keyboards
    }

    // Explicit: Mod = Super on TTY, Alt when nested
    mod-key "Super"
    mod-key-nested "Alt"

    touchpad {
        tap
        natural-scroll
        scroll-method "two-finger"
        accel-speed 0.1
        accel-profile "adaptive"
        tap-button-map "left-right-middle"
        dwt
        dwtp
        scroll-factor 1.2
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    trackpoint {
    }

    // Mouse focuses windows when you move over them (only if window is already on screen)
    focus-follows-mouse max-scroll-amount="0%"

    // Keep the cursor stationary while changing focus. This avoids accidental clicks,
    // especially with floating windows or when a second display is attached.

    // Press workspace number twice to jump back to previous workspace
    workspace-auto-back-and-forth
}

output "eDP-1" {
    mode "1366x768"
    scale 1
    transform "normal"
    position x=0 y=0
}

layout {
    // Dense, edge-to-edge tiling.
    gaps 0

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Focus ring off — using border instead
    focus-ring {
        off
    }

    // Subtle 1px border for focus visibility
    border {
        width 1
        active-color "#777777"
        inactive-color "#00000000"
        urgent-color "#e04f5f"
    }

    shadow {
        off
    }

    // Tab indicator: clean tabs, hidden when single
    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 0
        width 2
        gaps-between-tabs 0
        corner-radius 0
    }

    // Visual hint when interactively moving windows
    insert-hint {
        color "#3a3a3a80"
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    center-focused-column "never"
}

// ── Startup ────────────────────────────────────────────────────────────────

// Sync Wayland env into DBus/systemd so portals and tray work
spawn-at-startup "sh" "-c" "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP DISPLAY 2>/dev/null || true"

// Supervised by systemd user units in ~/.config/systemd/user:
// mako, eww, swayidle, wl-paste/cliphist, and niri_tile_to_n.py.
spawn-at-startup "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/swaybg_helper.sh\""
spawn-at-startup "nm-applet"
spawn-at-startup "sh" "-c" "exec swayosd-server --style \"${XDG_CONFIG_HOME:-$HOME/.config}/swayosd/style.css\" --top-margin 0.85"
spawn-at-startup "udiskie" "--tray"

// Battery status is provided by Eww.
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"


// XWayland integration — speeds up X11 app startup
xwayland-satellite {
    path "xwayland-satellite"
}

// ── Animations ─────────────────────────────────────────────────────────────
animations {
    // Fast, critically damped motion preserves spatial context without bounce.
    slowdown 0.8
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-open {
        off
    }
    window-close {
        off
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.001
    }
}
// ── Window rules ───────────────────────────────────────────────────────────

// Ghostty — let it decide its own initial size
window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    default-column-width {}
}

// Firefox picture-in-picture — floating bottom-right
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

// VSCode → workspace 1, maximized
window-rule {
    match app-id=r#"^code.*$"#
    open-on-workspace "1"
    open-maximized true
}

// Brave → workspace 2, maximized, XWayland resize fix
window-rule {
    match app-id=r#"^[Bb]rave.*$"#
    open-on-workspace "2"
    open-maximized true
    tiled-state true
    min-width 400
    min-height 300
}

// Zen browser
window-rule {
    match app-id=r#"^zen$"#
    open-maximized true
}

// Minecraft — fullscreen
window-rule {
    match title="Minecraft"
    open-fullscreen true
}

// Sharp corners everywhere
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

// Floating terminal (dedicated Ghostty D-Bus instance and Wayland app-id)
window-rule {
    match app-id="com.mishal.FloatingTerminal"
    open-floating true
    default-column-width { fixed 680; }
    default-window-height { fixed 330; }
}

// Keep transient notifications out of portal screencasts.
layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

// ── Keybindings ────────────────────────────────────────────────────────────

binds {
    // Modifier policy: Alt = general application/system actions; Mod (Super) = window/workspace/layout actions.

    // Always request a new window from the running Ghostty instance. Fall back
    // to starting Ghostty when no instance owns its D-Bus name yet.
    Alt+Return repeat=false hotkey-overlay-title="New Terminal" { spawn-sh "ghostty +new-window >/dev/null 2>&1 || exec ghostty"; }
    Alt+T      repeat=false hotkey-overlay-title="New Terminal" { spawn-sh "ghostty +new-window >/dev/null 2>&1 || exec ghostty"; }
    // A valid reverse-DNS class gives the floating terminal its own Ghostty
    // instance and Wayland app-id, independent from regular terminal windows.
    Alt+Shift+Return repeat=false hotkey-overlay-title="Toggle Floating Terminal" { spawn-sh "exec python3 \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_spawnjump.py\" 'ghostty --class=com.mishal.FloatingTerminal' com.mishal.FloatingTerminal --scratch"; }
    Alt+Shift+T      repeat=false hotkey-overlay-title="Toggle Floating Terminal" { spawn-sh "exec python3 \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_spawnjump.py\" 'ghostty --class=com.mishal.FloatingTerminal' com.mishal.FloatingTerminal --scratch"; }

    // Launcher & utilities
    Alt+Space repeat=false hotkey-overlay-title="Run Application" { spawn "fuzzel"; }
    Mod+V     repeat=false hotkey-overlay-title="Clipboard History" { spawn-sh "selected=$(cliphist list | fuzzel --dmenu); [ -n \"$selected\" ] && printf '%s\\n' \"$selected\" | cliphist decode | wl-copy"; }
    Alt+L     hotkey-overlay-title="Lock Screen"      { spawn-sh "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/swaylock/lock.sh\""; }
    Alt+E     hotkey-overlay-title="File Manager"     { spawn-sh "exec python3 \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_spawnjump.py\" nautilus"; }
    Alt+N     hotkey-overlay-title="WiFi Networks"    { spawn-sh "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/eww/scripts/network-choose.sh\""; }
    Alt+S hotkey-overlay-title="Toggle Orca" { spawn-sh "if ! command -v orca >/dev/null 2>&1; then notify-send 'Orca' 'Orca is not installed'; elif systemctl --user is-active --quiet niri-orca.service; then systemctl --user stop niri-orca.service; else systemctl --user start niri-orca.service; fi"; }

    // Wallpaper cycle
    Alt+B repeat=false hotkey-overlay-title="Next Wallpaper" { spawn-sh "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/swaybg_helper.sh\" --cycle -d"; }

    // Media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise" "--max-volume" "100"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower" "--max-volume" "100"; }
    XF86AudioMute        allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle" "--max-volume" "100"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "swayosd-client" "--input-volume" "mute-toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }

    Mod+O repeat=false { toggle-overview; }

    Alt+Q       repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+Shift+Q repeat=false hotkey-overlay-title="Force Kill Window" { spawn-sh "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_force_kill_focused.sh\""; }

    // Focus navigation
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // Move: columns/windows in tiling, 40 logical pixels when floating.
    Mod+Shift+Left  { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_move_focused.sh\" left"; }
    Mod+Shift+Down  { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_move_focused.sh\" down"; }
    Mod+Shift+Up    { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_move_focused.sh\" up"; }
    Mod+Shift+Right { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_move_focused.sh\" right"; }
    Mod+Shift+H     { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_move_focused.sh\" left"; }
    Mod+Shift+J     { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_move_focused.sh\" down"; }
    Mod+Shift+K     { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_move_focused.sh\" up"; }
    Mod+Shift+L     { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_move_focused.sh\" right"; }

    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // Workspace navigation — overview-aware: in overview moves workspaces, else focuses next
    Mod+Page_Down         { spawn-sh "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_overview_bind.sh\" move-workspace-down focus-workspace-down"; }
    Mod+Page_Up           { spawn-sh "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_overview_bind.sh\" move-workspace-up focus-workspace-up"; }
    Mod+Ctrl+Page_Down    { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up      { move-column-to-workspace-up; }
    Mod+Alt+Page_Down     { move-window-to-workspace-down; }
    Mod+Alt+Page_Up       { move-window-to-workspace-up; }
    Mod+Shift+Page_Down   { move-workspace-down; }
    Mod+Shift+Page_Up     { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Workspaces by number
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    // Move only the focused window; column movement remains on Mod+Ctrl+number.
    Mod+Alt+1 { move-window-to-workspace 1; }
    Mod+Alt+2 { move-window-to-workspace 2; }
    Mod+Alt+3 { move-window-to-workspace 3; }
    Mod+Alt+4 { move-window-to-workspace 4; }
    Mod+Alt+5 { move-window-to-workspace 5; }
    Mod+Alt+6 { move-window-to-workspace 6; }
    Mod+Alt+7 { move-window-to-workspace 7; }
    Mod+Alt+8 { move-window-to-workspace 8; }
    Mod+Alt+9 { move-window-to-workspace 9; }

    Mod+Alt+Tab       { focus-workspace-previous; }
    Mod+Alt+Shift+Tab { focus-workspace-down; }

    // Column management (also Mod+[ and Mod+] for consume-or-expel)
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R  { reset-window-height; }
    // Cycle window height preset: use with Mod+R first to adjust column width
    Mod+Alt+R { switch-preset-window-height; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M       { maximize-window-to-edges; }
    Mod+Ctrl+F  { expand-column-to-available-width; }

    Mod+C      { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Shift+C { center-window; }

    // Resize tiled windows by 10%; use precise 40px steps when floating.
    Mod+Ctrl+Left  { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_resize_focused.sh\" left"; }
    Mod+Ctrl+Right { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_resize_focused.sh\" right"; }
    Mod+Ctrl+Up    { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_resize_focused.sh\" up"; }
    Mod+Ctrl+Down  { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_resize_focused.sh\" down"; }
    Mod+Ctrl+H     { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_resize_focused.sh\" left"; }
    Mod+Ctrl+L     { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_resize_focused.sh\" right"; }
    Mod+Ctrl+K     { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_resize_focused.sh\" up"; }
    Mod+Ctrl+J     { spawn "sh" "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/niri_resize_focused.sh\" down"; }

    // Floating mode and layer focus. Niri also supports interactive Mod+drag.
    Mod+T       hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Shift+T hotkey-overlay-title="Switch Tiled/Floating Focus" { switch-focus-between-floating-and-tiling; }

    // Show hotkey overlay manually
    Mod+F1 { show-hotkey-overlay; }

    Mod+W { toggle-column-tabbed-display; }

    // Screenshots
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Mod+Print  { screenshot-window; }

    // Projector / TV: the service mirrors eDP-1 to HDMI-A-1 whenever connected.
    Alt+P      repeat=false hotkey-overlay-title="Start Projector Mirror" { spawn-sh "systemctl --user start niri-projector-mirror.service"; }
    Alt+Ctrl+P repeat=false hotkey-overlay-title="Stop Projector Mirror" { spawn-sh "systemctl --user stop niri-projector-mirror.service"; }

    // OCR — select area, extract text, copy to clipboard
    Alt+Shift+O hotkey-overlay-title="OCR Screenshot" { spawn-sh "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/ocr.sh\""; }

    // System
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Alt+Shift+Comma { spawn-sh "niri msg action load-config-file"; }
    Alt+Shift+E     { quit; }
    Ctrl+Alt+Delete  { quit; }
    Alt+Shift+P      { power-off-monitors; }

    // Multi-monitor
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Alt+Ctrl+Left    { move-window-to-monitor-left; }
    Mod+Alt+Ctrl+Right   { move-window-to-monitor-right; }
}
