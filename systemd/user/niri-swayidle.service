[Unit]
Description=Idle manager for Niri
PartOf=niri.service
After=niri.service
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
ExecStart=%h/.config/niri/scripts/niri_swayidle.sh
Restart=on-failure
RestartSec=1s
# PAM authentication uses the setuid unix_chkpwd helper to verify /etc/shadow.
# Enabling NoNewPrivileges here makes every swaylock password fail.
NoNewPrivileges=false

[Install]
WantedBy=niri.service
