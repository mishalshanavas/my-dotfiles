[Unit]
Description=Image clipboard history watcher for Niri
PartOf=niri.service
After=niri.service
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/wl-paste --type image --watch /usr/bin/cliphist store
Restart=on-failure
RestartSec=1s
NoNewPrivileges=true

[Install]
WantedBy=niri.service
