[Unit]
Description=Clear clipboard history when the Niri session ends
PartOf=niri.service
After=niri.service
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes
ExecStop=/usr/bin/cliphist wipe
NoNewPrivileges=true

[Install]
WantedBy=niri.service
