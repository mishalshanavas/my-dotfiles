[Unit]
Description=Eww bar for Niri
PartOf=niri.service
After=niri.service

[Service]
# Keep Eww in the foreground so systemd can restart it if the daemon dies.
Type=simple
ExecStartPre=-/usr/bin/eww kill
ExecStart=/usr/bin/eww --no-daemonize daemon
ExecStartPost=/usr/bin/bash -c 'for _ in {1..50}; do /usr/bin/eww ping >/dev/null 2>&1 && exec /usr/bin/eww open --id primary bar; sleep 0.1; done; exit 1'
ExecStopPost=-/usr/bin/eww close-all
ExecStopPost=-/usr/bin/eww kill
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=niri.service
