[Unit]
Description=Eww bar for Niri
PartOf=niri.service
After=niri.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Start from a clean daemon, then ask Eww to create one daemon and one named bar.
# Running `eww daemon` and `eww open` separately can produce two bar process
# trees on this Eww build.
ExecStartPre=-/usr/bin/eww kill
ExecStart=/usr/bin/eww --restart open --id primary bar
ExecStopPost=-/usr/bin/eww close-all
ExecStopPost=-/usr/bin/eww kill

[Install]
WantedBy=niri.service
