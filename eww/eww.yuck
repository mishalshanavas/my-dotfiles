;; ── Eww Bar - Compact Minimal ────────────────────────────────
;; Dependencies: nmcli, pactl, upower, bluetoothctl, fuzzel, niri

;; ─── Clock ──────────────────────────────────────────────────

(defpoll clock :interval "1s"
  `date +"%I:%M %p"`)

(defpoll date_tooltip :interval "60s"
  `date +"%A, %d %B %Y"`)

;; ─── Workspaces (niri) ──────────────────────────────────────

(defvar workspace_1 "○")
(defvar workspace_2 "○")
(defvar workspace_3 "○")
(defvar workspace_4 "○")
(defvar workspace_5 "○")
(defvar workspace_6 "○")
(defvar workspace_7 "○")
(defvar workspace_8 "○")
(defvar workspace_9 "○")
(defvar workspace_visible_1 "false")
(defvar workspace_visible_2 "false")
(defvar workspace_visible_3 "false")
(defvar workspace_visible_4 "false")
(defvar workspace_visible_5 "false")
(defvar workspace_visible_6 "false")
(defvar workspace_visible_7 "false")
(defvar workspace_visible_8 "false")
(defvar workspace_visible_9 "false")

(deflisten workspace_sync :initial ""
  `$HOME/.config/eww/scripts/workspaces.sh`)

;; ─── Network ────────────────────────────────────────────────

(deflisten network :initial ""
  `$HOME/.config/eww/scripts/network.sh`)

;; ─── Volume ─────────────────────────────────────────────────

(deflisten volume :initial ""
  `$HOME/.config/eww/scripts/volume.sh`)

;; ─── Brightness ─────────────────────────────────────────────

(deflisten brightness :initial ""
  `$HOME/.config/eww/scripts/brightness.sh`)

;; ─── Battery ────────────────────────────────────────────────

(deflisten battery :initial ""
  `$HOME/.config/eww/scripts/battery.sh`)

;; Alternates true/false every second; used to blink the battery
;; label when the charge is critical.
(defpoll battery_blink :interval "1s"
  `$HOME/.config/eww/scripts/battery-blink.sh`)

;; ─── Music (MPRIS) ──────────────────────────────────────────

(deflisten music :initial ""
  `$HOME/.config/eww/scripts/music.sh`)

;; ─── Caffeine ───────────────────────────────────────────────

(deflisten caffeine :initial ""
  `$HOME/.config/eww/scripts/caffeine-watch.sh`)

;; ─── Bluetooth ──────────────────────────────────────────────

(deflisten bluetooth :initial ""
  `$HOME/.config/eww/scripts/bluetooth-watch.sh`)

;; ─── Widgets ────────────────────────────────────────────────

(defwidget workspaces-widget []
  (box :class "workspaces" :spacing 0
    (label :text workspace_sync :visible false)
    (button :onclick "niri msg action focus-workspace 1" :tooltip "Workspace 1" :visible {workspace_visible_1 == "true" ? "true" : "false"} (label :text workspace_1))
    (button :onclick "niri msg action focus-workspace 2" :tooltip "Workspace 2" :visible {workspace_visible_2 == "true" ? "true" : "false"} (label :text workspace_2))
    (button :onclick "niri msg action focus-workspace 3" :tooltip "Workspace 3" :visible {workspace_visible_3 == "true" ? "true" : "false"} (label :text workspace_3))
    (button :onclick "niri msg action focus-workspace 4" :tooltip "Workspace 4" :visible {workspace_visible_4 == "true" ? "true" : "false"} (label :text workspace_4))
    (button :onclick "niri msg action focus-workspace 5" :tooltip "Workspace 5" :visible {workspace_visible_5 == "true" ? "true" : "false"} (label :text workspace_5))
    (button :onclick "niri msg action focus-workspace 6" :tooltip "Workspace 6" :visible {workspace_visible_6 == "true" ? "true" : "false"} (label :text workspace_6))
    (button :onclick "niri msg action focus-workspace 7" :tooltip "Workspace 7" :visible {workspace_visible_7 == "true" ? "true" : "false"} (label :text workspace_7))
    (button :onclick "niri msg action focus-workspace 8" :tooltip "Workspace 8" :visible {workspace_visible_8 == "true" ? "true" : "false"} (label :text workspace_8))
    (button :onclick "niri msg action focus-workspace 9" :tooltip "Workspace 9" :visible {workspace_visible_9 == "true" ? "true" : "false"} (label :text workspace_9))))

(defwidget clock-widget []
  (label :text clock :class "clock" :tooltip date_tooltip))

(defwidget music-widget []
  (button :onclick "bash $HOME/.config/eww/scripts/music-toggle.sh"
          :class "music"
          :tooltip "Play / pause"
          :visible {music != "" ? "true" : "false"}
    (label :text music)))

(defwidget caffeine-widget []
  (button :onclick "$HOME/.config/eww/scripts/caffeine-toggle.sh"
      :class {caffeine == "true" ? "caffeine caffeine-active" : "caffeine"}
          :tooltip "Toggle automatic sleep inhibition"
    (label :text {caffeine == "true" ? "" : ""})))

(defwidget network-widget []
  (button :onclick "$HOME/.config/eww/scripts/network-choose.sh &"
          :onrightclick "$HOME/.config/eww/scripts/network-choose.sh --tui &"
      :class {matches(network, "(Off|Down|N/A)$") ? "network network-disconnected" : "network"}
          :tooltip "Left: WiFi networks / Right: nmtui"
    (label :text network)))

(defwidget bluetooth-widget []
  (button :onclick "$HOME/.config/eww/scripts/bluetooth-click.sh"
          :class "bluetooth"
          :tooltip bluetooth
    (label :text bluetooth)))

(defwidget volume-widget []
  (button :onclick "pactl set-sink-volume @DEFAULT_SINK@ +5%"
          :onrightclick "pactl set-sink-volume @DEFAULT_SINK@ -5%"
          :onmiddleclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    :class {matches(volume, "Muted$") ? "volume volume-muted" : "volume"}
    :tooltip "Left: volume up / Right: volume down / Middle: mute"
    (label :markup volume)))

(defwidget brightness-widget []
  (button :onclick "$HOME/.config/eww/scripts/brightness-adjust.sh up"
          :onrightclick "$HOME/.config/eww/scripts/brightness-adjust.sh down"
    :class "brightness"
    :tooltip "Left: brighter / Right: dimmer"
    (label :text brightness)))

(defwidget battery-widget []
  (button :class {matches(battery, " ([0-9]|10)%$") ? (battery_blink == "true" ? "battery battery-critical battery-blink" : "battery battery-critical") : (matches(battery, " ([0-9]|1[0-9]|20)%$") ? "battery battery-low" : "battery")}
    :tooltip "Battery charge"
    (label :text battery)))

(defwidget power-widget []
  (button :onclick "$HOME/.config/eww/scripts/power.sh &"
    :class "power"
    :tooltip "Power menu"
    (label :text "")))

;; ─── Bar Window ─────────────────────────────────────────────

(defwindow bar
  :monitor 0
  :geometry (geometry
              :x "0%"
              :y "0%"
              :width "100%"
              :height 24
              :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  :windowtype "dock"
  :hexpand true
  :vexpand false
  (centerbox :class "bar"
    ;; LEFT
    (box :halign "start" :space-evenly false
      (workspaces-widget))
    ;; CENTER
    (box :hexpand true :halign "center" :space-evenly false
      (clock-widget))
    ;; RIGHT
    (box :hexpand true :halign "end" :space-evenly false :spacing 1
      (music-widget)
      (caffeine-widget)
      (network-widget)
      (bluetooth-widget)
      (volume-widget)
      (brightness-widget)
      (battery-widget)
      (power-widget))))
